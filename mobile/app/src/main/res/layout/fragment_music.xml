<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".ui.music.MusicFragment">

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iconFavorite"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_star_filled"
                        app:tint="@color/app_accent_soft" />

                    <TextView
                        android:id="@+id/textFavorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:letterSpacing="0.1"
                        android:text="FAVORI"
                        android:textAllCaps="true"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iconRiff"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_riff"
                        app:tint="@color/app_accent_soft" />

                    <TextView
                        android:id="@+id/textRiff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:letterSpacing="0.1"
                        android:text="RIFF"
                        android:textAllCaps="true"
                        android:textColor="@color/app_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textBpm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/app_accent_soft"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="140 BPM · 4/4" />

            </LinearLayout>

            <TextView
                android:id="@+id/titleChords"
                style="@style/AppSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accords" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupChords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="4dp" />

            <TextView
                style="@style/AppSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progression" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/seekBarProgress"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progressDrawable="@drawable/seekbar_progress"
                    android:thumb="@android:color/transparent"
                    android:splitTrack="false" />

                <TextView
                    android:id="@+id/textProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:minWidth="48dp"
                    android:textColor="@color/app_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/AppSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Difficulté" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:chipSpacingHorizontal="8dp"
                app:singleSelection="true"
                app:selectionRequired="true"/>


            <TextView
                style="@style/AppSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Commentaire" />

            <EditText
                android:id="@+id/textComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_card"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:lineSpacingExtra="4dp"
                android:minHeight="100dp"
                android:padding="16dp"
                android:textColor="@color/app_text_primary"
                android:textColorHint="@color/app_text_secondary"
                android:textSize="14sp"
                android:hint="Ajouter une note personnelle..." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPartition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Partition"
                    android:textAllCaps="false"
                    android:textColor="@color/app_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/app_accent"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTablature"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Tablature"
                    android:textAllCaps="false"
                    android:textColor="@color/app_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/app_accent_tab"
                    app:cornerRadius="10dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>