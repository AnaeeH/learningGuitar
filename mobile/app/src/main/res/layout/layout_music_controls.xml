<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/app_surface"
    android:gravity="center_vertical">

    <Button
        android:id="@+id/btnSkipBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="⏮"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Précédent"
        android:padding="6dp" />

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="▶"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Lire"
        android:padding="6dp" />

    <Button
        android:id="@+id/btnSkipForward"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="⏭"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Suivant"
        android:padding="6dp" />

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:padding="6dp"
        android:progressDrawable="@drawable/seekbar_progress"
        android:splitTrack="false"
        android:thumb="@android:color/transparent" />

    <TextView
        android:id="@+id/textDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:fontFeatureSettings="tnum"
        android:text="0:00 / 0:00"
        android:padding="6dp"
        android:textColor="@color/app_text_primary"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnSpeedDown"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="−"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Ralentir"
        android:padding="6dp" />

    <TextView
        android:id="@+id/textSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:minWidth="40dp"
        android:gravity="center"
        android:padding="6dp"
        android:text="100%"
        android:textColor="@color/app_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSpeedUp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="+"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Accélérer"
        android:padding="6dp" />

</LinearLayout>