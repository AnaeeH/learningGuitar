<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_background">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dark_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zone tablature"
            android:textColor="@color/dark_textSecondary" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dark_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/dark_background2"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnSkipBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="⏮"
            android:backgroundTint="@color/dark_background2"
            android:textColor="@color/dark_text"
            android:padding="0dp" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="▶"
            android:backgroundTint="@color/dark_background2"
            android:textColor="@color/dark_text"
            android:layout_marginStart="8dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/btnSkipForward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="⏭"
            android:backgroundTint="@color/dark_background2"
            android:textColor="@color/dark_text"
            android:layout_marginStart="8dp"
            android:padding="0dp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:progressTint="@color/dark_mainColor"
            android:thumbTint="@color/dark_mainColor" />

        <TextView
            android:id="@+id/textDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00 / 0:00"
            android:textColor="@color/dark_textSecondary"
            android:textSize="12sp"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnSpeedDown"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="−"
            android:backgroundTint="@color/dark_background2"
            android:textColor="@color/dark_text"
            android:padding="0dp" />

        <TextView
            android:id="@+id/textSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="@color/dark_text"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSpeedUp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="+"
            android:backgroundTint="@color/dark_background2"
            android:textColor="@color/dark_text"
            android:padding="0dp" />



    </LinearLayout>

</LinearLayout>